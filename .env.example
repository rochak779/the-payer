# Copy to .env.local. Everything defaults to offline fakes.
# DB_PATH=data/db.json

# Which implementation to use for each outside service:
# CHECKER=keyword      # keyword | claude | claude-haiku | gemini
# PARSER=pattern       # pattern | claude | gemini
# SEARCH=fixtures      # fixtures | firecrawl
# SHOPPER=scripted     # scripted | claude | gemini
# PAYMENTS=fake        # fake | stripe | paypal (ISSUER is still read when PAYMENTS is unset)

# Claude (Phase 8). Or run `ant auth login` instead of setting a key.
# ANTHROPIC_API_KEY=sk-ant-...
# CHECKER_MODEL=claude-sonnet-5-5     # or claude-haiku-5-5 for a cheap comparison
# CHECKER_EFFORT=medium               # low | medium | high
# AGENT_MODEL=claude-sonnet-5-5

# Gemini: free stopgap with the same prompts as Claude. Google may use free-tier prompts: mock data only.
# Default model is the free gemini-3.5-flash-lite: 500 calls a day (one eval run is 67, one agent task up to 12).
# gemini-3.8-flash is capped at about 5 calls a minute and 20 a day, too few for the 67-case eval.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Firecrawl (Phase 8): real web search when SEARCH=firecrawl
# FIRECRAWL_API_KEY=fc-...

# Stripe sandbox (Phase 8). Test keys only: the code refuses anything not starting sk_test_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CARDHOLDER_ID=ich_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENTS=stripe

# PayPal sandbox (hackathon). Sandbox only: the code always calls api-m.sandbox.paypal.com.
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_VAULT_ID=...          # the demo buyer, used until someone presses "Connect PayPal" (written by `npm run paypal:spike vault-finish <id>`)
# APP_URL=http://localhost:3000  # where PayPal sends the buyer back after "Connect PayPal" (the hosted URL on Render)
# PAYMENTS=paypal

# Hosted demo (Render): each visitor gets their own seeded data file under data/visitors/.
# HOSTED=1
# Daily caps on live AI use when HOSTED=1 (past a cap, runs use the offline agent):
# LIMIT_TASKS_PER_VISITOR=8
# LIMIT_TASKS_PER_DAY=30
# LIMIT_PREVIEWS_PER_VISITOR=20
