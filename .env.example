# Copy to .env.local. Everything defaults to offline fakes.
# DB_PATH=data/db.json

# Which implementation to use for each outside service:
# CHECKER=keyword      # keyword | claude | claude-haiku | gemini
# PARSER=pattern       # pattern | claude | gemini
# SEARCH=fixtures      # fixtures | firecrawl
# SHOPPER=scripted     # scripted | claude | gemini
# ISSUER=fake          # fake | stripe

# Claude (Phase 8). Or run `ant auth login` instead of setting a key.
# ANTHROPIC_API_KEY=sk-ant-...
# CHECKER_MODEL=claude-sonnet-5-5     # or claude-haiku-5-5 for a cheap comparison
# CHECKER_EFFORT=medium               # low | medium | high
# AGENT_MODEL=claude-sonnet-5-5

# Gemini: free stopgap with the same prompts as Claude. Google may use free-tier prompts: mock data only.
# Default model is the free gemini-3.5-flash-lite (hundreds of calls a day without limit errors).
# gemini-3.8-flash is capped at about 5 calls a minute and 20 a day, too few for the 67-case eval.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Firecrawl (Phase 8): real web search when SEARCH=firecrawl
# FIRECRAWL_API_KEY=fc-...

# Stripe sandbox (Phase 8). Test keys only: the code refuses anything not starting sk_test_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CARDHOLDER_ID=ich_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ISSUER=stripe
